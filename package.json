{
  "name": "@local/dsh-mobile-topbar",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "DeepSeek Harness Web UI plugin: on phone-sized viewports, turns the left sidebar into a horizontal top bar above the conversation.",
  "license": "MIT",
  "keywords": ["deepseek-harness", "dsh", "dsh-plugin", "cordis", "mobile", "layout"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nu0y4/dsh-mobile-topbar.git"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": ["index.js", "client.js", "cordis.patch.yml", "locale/*.json", "icon.svg", "README.md", "LICENSE"],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
